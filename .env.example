# Credenciais do aplicativo criado em https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=""

# Opcional. Se vazio, o Telethon pede o telefone no primeiro login.
TELEGRAM_PHONE=

# Username da conta pessoal que executara o listener (nao e o canal).
# Pode ficar vazio caso a conta nao tenha username ou ainda nao seja conhecido.
EXPECTED_ACCOUNT_USERNAME=

# Destino fixo. O programa envia somente o contrato extraido.
DESTINATION_CHAT=@helenus_trojanbot

# Canais de origem confirmados, separados por virgula.
SOURCE_CHATS=@kenjihl,@cyberleek_io_io
ALLOW_ANY_PRIVATE_SOURCE=false

# auto aceita contratos Solana e EVM. Valores: auto, solana, evm.
CONTRACT_NETWORK=auto

# Comece em true. Troque para false somente depois de validar os logs.
DRY_RUN=true

# Alerta apos envio confirmado: 8 beeps de 8 s, a 888 Hz.
BEEP_ENABLED=true
BEEP_FREQUENCY_HZ=888
BEEP_DURATION_MS=8000
BEEP_REPEAT=8
BEEP_GAP_MS=250

# Estado local. Nunca envie nem publique o arquivo .session.
TELEGRAM_SESSION=.data/kenjihl
STATE_DB=.data/forwarder.sqlite3
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Wallet Guard: preflight EVM estritamente read-only, separado do Telegram.
# Nunca coloque seed phrase aqui. A chave privada fica somente no .env local.
# Escolha as redes desejadas entre:
# ethereum,stable,base,bnb,robinhood,arbitrum,hyperevm,avalanche
WALLET_GUARD_DRY_RUN=true
WALLET_GUARD_SIGNING_ENABLED=false
WALLET_GUARD_BROADCAST_ENABLED=false
# Chave da carteira de origem. Mantenha este arquivo local e nunca compartilhe.
WALLET_GUARD_PRIVATE_KEY=""
WALLET_GUARD_REQUIRE_PROXY=true
WALLET_GUARD_RETRY_ATTEMPTS=10
WALLET_GUARD_RPC_TIMEOUT_SECONDS=15
WALLET_GUARD_SOURCE_WALLET=
# Um unico destino protegido, usado em todas as redes habilitadas.
WALLET_GUARD_SAFE_WALLET=
# Um unico proxy, usado para acessar os RPCs de todas as redes habilitadas.
# Aceita http://, https://, socks5:// ou socks5h://. Credenciais somente no .env.
WALLET_GUARD_PROXY_URL=
WALLET_GUARD_CHAINS=ethereum,stable,base,bnb,robinhood,arbitrum,hyperevm,avalanche

# RPCs abaixo sao publicos/compartilhados: bons para preflight, sem SLA de producao.
# Use RPC dedicado/autenticado antes de qualquer futuro fluxo real de resgate.
# Um RPC HTTPS por rede habilitada; todos passam pelo proxy global acima.
# Escopo do Wallet Guard: somente a moeda nativa de cada rede; nenhum token.

# Ethereum | chainId=1 | nativo=ETH | explorer=https://etherscan.io
# Terceiro: PublicNode. Ethereum nao oferece um unico RPC publico oficial.
WALLET_GUARD_RPC_ETHEREUM=https://ethereum-rpc.publicnode.com

# Stable | chainId=988 | nativo/gas=USDT0 (18 decimais)
# EIP-1559 sem priority tip: o executor fixa maxPriorityFeePerGas=0.
# Explorer=https://stablescan.xyz | WSS=wss://rpc.stable.xyz
WALLET_GUARD_RPC_STABLE=https://rpc.stable.xyz

# Base | chainId=8453 | nativo=ETH | explorer=https://base.blockscout.com
# Publico oficial, rate-limited e nao indicado pela Base para producao.
# WSS=wss://mainnet.base.org
WALLET_GUARD_RPC_BASE=https://mainnet.base.org

# BNB Smart Chain | chainId=56 (0x38) | nativo=BNB
# Explorer=https://bscscan.com | limite documentado=10.000 req/5 min
# Alternativa oficial: https://bsc-dataseed-public.bnbchain.org
# Observacao: eth_getLogs e desabilitado nestes endpoints publicos; o preflight nao o usa.
WALLET_GUARD_RPC_BNB=https://bsc-dataseed.bnbchain.org

# Robinhood Chain | chainId=4663 | nativo=ETH
# Explorer=https://robinhoodchain.blockscout.com
# Publico oficial e rate-limited; nao indicado para alto volume/producao.
# Arbitrum Nitro: a estimativa inclui custo L1; o executor adiciona margem.
WALLET_GUARD_RPC_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com

# Arbitrum One | chainId=42161 | nativo=ETH | explorer=https://arbiscan.io
# Publico oficial sem garantia de uptime, latencia ou rate limit; sem WSS publico oficial.
WALLET_GUARD_RPC_ARBITRUM=https://arb1.arbitrum.io/rpc

# HyperEVM | chainId=999 | nativo=HYPE | explorer=https://hyperevmscan.io
# Oficial: 100 requisicoes EVM/min; sem WSS. Leituras de estado usam "latest".
# Alternativa de terceiro: https://hyperliquid-json-rpc.stakely.io
WALLET_GUARD_RPC_HYPEREVM=https://rpc.hyperliquid.xyz/evm

# Avalanche C-Chain | chainId=43114 (0xA86A) | nativo=AVAX
# Explorer=https://explorer.avax.network/c-chain
WALLET_GUARD_RPC_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
